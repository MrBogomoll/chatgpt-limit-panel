{
  "name": "quota-panel",
  "version": "1.2.1-beta.3",
  "private": true,
  "description": "A Windows quota monitor for Codex / Work, with a local ChatGPT plugin controller.",
  "engines": {
    "node": ">=24"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "scripts": {
    "test": "node --test tests/plugin-reader.test.mjs tests/plugin-quota.test.mjs tests/quota-panel-*.test.mjs tests/overlay-*.test.mjs",
    "test:overlay": "node --test tests/overlay-*.test.mjs",
    "test:plugin": "node --test tests/plugin-reader.test.mjs tests/plugin-quota.test.mjs tests/quota-panel-*.test.mjs",
    "build:overlay": "node overlay/build.mjs",
    "package:plugin": "node --input-type=module -e \"import { packagePlugin } from './overlay/package-plugin.mjs'; console.log(JSON.stringify(packagePlugin({ nodeLicensePath: 'third-party/NODE-LICENSE.txt' }), null, 2));\""
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
